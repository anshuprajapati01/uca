# Universal College App (UCA) — Supabase configuration
#
# Setup:
#   1. Copy this file to `.env.local` in the project root (same folder as package.json)
#   2. Open your Supabase project → Settings → API
#   3. Paste the values below
#
# Never commit `.env.local` — it is ignored by Git.

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Publishable key (Settings → API → Project API keys → publishable / anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=
